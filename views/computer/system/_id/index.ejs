<h1>
  <span class="badge badge-primary">system:</span>
  <code><%= locals.machineName %></code>
</h1>
<div class='row'>
  <div class="col-9">
    <h2>Hardware</h2>
  <% const parts = locals.hardware || []; %>
  <% const info = locals.hardwareInfo || {}; %>
  <% if (parts.length > 0) { %>
    <table class='table'>
      <thead>
        <tr>
          <th>Type</th>
          <th>Name</th>
        </tr>
      </thead>
      <tbody>
      <% parts.forEach((part) => { %>
        <tr>
          <td><span class="badge badge-primary"><%= (info[part] || {}).type %></span></td>
          <td><a href='/computer/hardware/<%=part%>/'><%= (info[part] || {}).name || part %></a></td>
        </tr>
      <% }) %>
      </tbody>
    </table>
  <% } else { %>
    <p class='text-muted'>No hardware catalogued yet.</p>
  <% } %>
  </div>
  <div class="col">
  <% if (locals.justification) { %>
    <div class="card">
      <div class="card-body">
        <%- justification %>
      </div>
    </div>
  <% } %>
  </div>
</div>
